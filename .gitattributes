# Files listed here stay in the repo but are left out of the user download
# that .github/workflows/release.yml builds with `git archive`.
# Anything not listed ships, so a new file is included by default.
# config.json (your tastytrade credentials) is gitignored, so it is never
# committed and can never be in the download.
.gitattributes   export-ignore
.gitignore       export-ignore
.github/         export-ignore
docs/            export-ignore
